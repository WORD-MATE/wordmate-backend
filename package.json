{
  "name": "wordmate-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "nest build && node dist/seed.js",
    "ranking:rebuild": "nest build && node dist/ranking-rebuild.js",
    "jwt:keygen": "node scripts/generate-jwt-key.mjs",
    "datagsm:login": "node scripts/datagsm-login.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.11",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/platform-ws": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.5.0",
    "bullmq": "6.7.6",
    "csv-parse": "7.0.3",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "uuid": "14.0.3",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@testcontainers/mysql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "drizzle-kit": "1.0.0-rc.5",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
