  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
